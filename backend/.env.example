# REVIXA BACKEND ENVIRONMENT CONFIGURATION
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:8080,https://f-seven-orcin.vercel.app

# DATABASE CONFIGURATION (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revixa_db?schema=public

# JWT AUTHENTICATION
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# TOKEN ENCRYPTION (AES-256-GCM 32-byte hex string)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# SHOPIFY OAUTH CREDENTIALS
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_SCOPES=read_orders,read_products,read_inventory,read_customers
SHOPIFY_REDIRECT_URI=http://localhost:5000/auth/shopify/callback

# OPENAI AI PIPELINE
OPENAI_API_KEY=your_openai_api_key
